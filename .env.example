NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Required for inline Korean translation on brief cards (claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=

# Optional News API integration for the main brief feed
# Get a key from https://newsapi.org and set NEWS_API_KEY to enable it.
NEWS_API_KEY=
NEWS_API_QUERY="(crypto OR bitcoin OR ethereum OR blockchain OR stock market OR economy OR federal reserve)"
NEWS_API_LANGUAGE=en
NEWS_API_PAGE_SIZE=40
NEWS_API_LOOKBACK_DAYS=3
# Optional comma-separated filters:
# NEWS_API_SOURCES=
# NEWS_API_DOMAINS=
# NEWS_API_EXCLUDE_DOMAINS=

# Required for background browser push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@chainbrief.kr
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4572550568039838

# NOWPayments crypto invoices (USDT / USDC)
# Get these from https://nowpayments.io → Store Settings → API Keys
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
